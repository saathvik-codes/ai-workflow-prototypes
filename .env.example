# Root environment template
# Keep secrets out of the repository.

Q1_HOST=127.0.0.1
Q1_PORT=8081

# Optional production integrations, not required for the local prototype.
# The assessment accepts a web calling interface, so these stay empty unless
# you choose to connect real telephony/ASR/TTS later.
